# =============================================================================
# Precifarm Ticketing CMS — environment variables
# =============================================================================
# 1. Copy this file to `.env` (same folder). `.env` is gitignored — never commit it.
# 2. Fill in live secrets only in `.env`, not in this example file.
# 3. Restart CMS after changes: npm run dev
#
# Payment modes:
#   demo            — DEMO_PAYMENT=true OR missing M-Pesa vars (simulated STK, no charge)
#   live-sandbox    — DEMO_PAYMENT=false + all MPESA_* + MPESA_ENVIRONMENT=sandbox
#   live-production — DEMO_PAYMENT=false + all MPESA_* + MPESA_ENVIRONMENT=production
# =============================================================================

# --- Supabase PostgreSQL ---
# Option A: password only (setup script builds URLs)
# SUPABASE_DB_PASSWORD=your-database-password
# Option B: full pooler URI (for local runtime — use your project host from Supabase dashboard)
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Then run: npm run supabase:setup
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# --- Payment mode ---
# Keep true for local dev without Daraja. Set false only when all MPESA_* below are set.
DEMO_PAYMENT=true

# --- M-Pesa Daraja (server secrets — live STK) ---
# From https://developer.safaricom.co.ke → My Apps → your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Lipa Na M-Pesa Online passkey (not the consumer secret)
MPESA_PASSKEY=
# Sandbox paybill is usually 174379; production = your till/paybill number
MPESA_SHORTCODE=174379
# Must be publicly reachable HTTPS in live mode
# GCP production: https://api.precifarm.com/api/v1/payments/mpesa/callback
MPESA_CALLBACK_URL=http://localhost:3002/api/v1/payments/mpesa/callback
# sandbox | production
MPESA_ENVIRONMENT=sandbox

# Phone number for scripts/test-stk.mjs (2547XXXXXXXX — must receive STK in live mode)
MPESA_TEST_PHONE=254708374149

# --- Security (required in production) ---
# HMAC key for the agent session cookie. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production refuses logins when unset (fail closed). Dev falls back to a random per-process key.
SESSION_SECRET=
# Shared secret appended to the STK CallBackURL as ?token=... and checked on every callback.
# Production (NODE_ENV=production or MPESA_ENVIRONMENT=production) rejects callbacks and
# refuses to send STK pushes when unset. Generate the same way as SESSION_SECRET.
MPESA_CALLBACK_TOKEN=
# Optional comma separated allowlist of Safaricom callback source IPs. Leave empty to disable.
# Checked against the right-most X-Forwarded-For entry (the one the Cloud Run front end appends).
# MPESA_CALLBACK_ALLOWED_IPS=
# Accept legacy plaintext agent passwords and upgrade them to scrypt on successful login.
# Default false. Enable only briefly during migration, then set back to false.
ALLOW_LEGACY_PLAINTEXT=false
# Passwords for the seeded agent@ and admin@ accounts (first seed only; stored as scrypt hashes).
# If unset, the seed generates random passwords and prints them once to the console in dev only.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=

# --- Retired booking surface ---
# Passenger and cargo booking is retired. When false (default), booking creation, seat
# availability and STK push routes return HTTP 410. Admin read-only views still work.
BOOKING_ENABLED=false

# --- Analytics (Phase 2 — requires PostgreSQL) ---
# ANALYTICS_ENVIRONMENT=development
# ANALYTICS_INGEST_ENABLED=true
# Optional shared key for POST /api/v1/analytics/events (website + mobile)
# ANALYTICS_INGEST_KEY=

# Optional cron secret for POST /api/v1/analytics/aggregate
# ANALYTICS_CRON_KEY=

# --- SEO / AISO (Phase 2–4 — requires PostgreSQL) ---
# Public site URL for seeded content links and agent API manifests
NEXT_PUBLIC_SITE_URL=https://precifarm.com
# OpenAI embeddings for semantic search (text-embedding-3-small)
# OPENAI_API_KEY=
# Optional override: SEO_EMBEDDING_MODEL=text-embedding-3-small
# Optional override: SEO_CONTENT_MODEL=gpt-4o-mini
# Stale content threshold in days (default 90)
# SEO_STALE_DAYS=90
# Android App Links SHA-256 cert fingerprint (website .well-known)
# ANDROID_APP_SHA256=
# Cron secret for POST /api/v1/seo/metrics and GET /api/v1/seo/report
# SEO_CRON_KEY=
# GA4 property ID (for future automated ingest scripts)
# GA4_PROPERTY_ID=

# --- Live production example (placeholders only — set real values in `.env`) ---
# DEMO_PAYMENT=false
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=https://api.precifarm.com/api/v1/payments/mpesa/callback
# MPESA_ENVIRONMENT=production
# SESSION_SECRET=
# MPESA_CALLBACK_TOKEN=
