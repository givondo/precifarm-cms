# =============================================================================
# Precifarm Ticketing CMS — environment variables
# =============================================================================
# 1. Copy this file to `.env` (same folder). `.env` is gitignored — never commit it.
# 2. Fill in live secrets only in `.env`, not in this example file.
# 3. Restart CMS after changes: npm run dev
#
# Payment modes:
#   demo            — DEMO_PAYMENT=true OR missing M-Pesa vars (simulated STK, no charge)
#   live-sandbox    — DEMO_PAYMENT=false + all MPESA_* + MPESA_ENVIRONMENT=sandbox
#   live-production — DEMO_PAYMENT=false + all MPESA_* + MPESA_ENVIRONMENT=production
# =============================================================================

# --- Database ---
# Local Docker: postgresql://precifarm:precifarm@localhost:5433/ticketing_cms
# Supabase (production): use Transaction pooler URI from Project Settings → Database
# Example: postgresql://postgres.wvqkhvimsxgyxryehnom:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Omit DATABASE_URL to use JSON file store under data/ (local dev only)
DATABASE_URL=

# --- Payment mode ---
# Keep true for local dev without Daraja. Set false only when all MPESA_* below are set.
DEMO_PAYMENT=true

# --- M-Pesa Daraja (server secrets — live STK) ---
# From https://developer.safaricom.co.ke → My Apps → your app
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Lipa Na M-Pesa Online passkey (not the consumer secret)
MPESA_PASSKEY=
# Sandbox paybill is usually 174379; production = your till/paybill number
MPESA_SHORTCODE=174379
# Must be publicly reachable HTTPS in live mode (use ngrok for local testing)
MPESA_CALLBACK_URL=http://localhost:3002/api/v1/payments/mpesa/callback
# sandbox | production
MPESA_ENVIRONMENT=sandbox

# Phone number for scripts/test-stk.mjs (2547XXXXXXXX — must receive STK in live mode)
MPESA_TEST_PHONE=254708374149

# --- Live production example (do not paste real values here) ---
# DEMO_PAYMENT=false
# MPESA_CONSUMER_KEY=your_production_key
# MPESA_CONSUMER_SECRET=your_production_secret
# MPESA_PASSKEY=your_lipa_na_mpesa_passkey
# MPESA_SHORTCODE=your_paybill
# MPESA_CALLBACK_URL=https://cms.precifarm.co.ke/api/v1/payments/mpesa/callback
# MPESA_ENVIRONMENT=production
