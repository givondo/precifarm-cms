{
  "name": "precifarm-ticketing-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002 --turbopack",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "node scripts/ensure-dev-stopped.mjs && next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed-postgres.ts",
    "test:mpesa-auth": "node scripts/test-mpesa-auth.mjs",
    "test:stk": "node scripts/test-stk.mjs",
    "tunnel:mpesa": "node scripts/start-mpesa-tunnel.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "15.2.4",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
