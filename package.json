{
  "name": "precifarm-ticketing-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002 --turbopack",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "node scripts/ensure-dev-stopped.mjs && next build",
    "build:netlify": "next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed-postgres.ts",
    "db:seed-seo": "npx tsx scripts/seed-seo.ts",
    "supabase:setup": "node scripts/setup-supabase.mjs",
    "supabase:seo": "node scripts/setup-supabase-seo.mjs",
    "netlify:database-url": "node scripts/print-netlify-database-url.mjs",
  "analytics:aggregate": "npx tsx scripts/aggregate-analytics-daily.ts",
    "seo:embeddings": "npx tsx scripts/seo-generate-embeddings.ts",
    "seo:report": "npx tsx scripts/seo-weekly-report.ts",
    "seo:local-pages": "npx tsx scripts/generate-local-pages.ts",
    "seo:ingest-citations": "npx tsx scripts/seo-ingest-ai-referrals.ts",
    "seo:refresh-stale": "npx tsx scripts/seo-refresh-stale.ts",
    "seo:competitors": "npx tsx scripts/seo-competitor-check.ts",
    "analytics:views": "node scripts/create-analytics-views.mjs",
    "analytics:cron": "netlify functions:invoke analytics-daily",
    "test:mpesa-auth": "node scripts/test-mpesa-auth.mjs",
    "test:stk": "node scripts/test-stk.mjs",
    "tunnel:mpesa": "node scripts/start-mpesa-tunnel.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.21",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
